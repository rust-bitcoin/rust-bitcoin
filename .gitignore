# .gitignore for rust-bitcoin repository workspace.

# Ignore root lockfile, but track subdirectories for tooling.
/Cargo.lock

# Build artifacts
target

# Test artifacts
mutants.out*
fuzz/coverage

# Generated API snapshot files
*/api/

# Local tooling (rbmt)
Cargo.lock.backup

# Proofs generated by creusot
verif
# Some kind of cache for why3find - the creusot's backend
.why3find
